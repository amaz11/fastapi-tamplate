# Copy to .env before first run:
#   cp .env.example .env

# --- App ---
APP_NAME=FastAPI Template
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

# JWT signing. Use a long random string in production.
SECRET_KEY=dev-only-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ALGORITHM=HS256

# --- Database ---
# SQLite (default, no extra setup):
DATABASE_URL=sqlite:///./dev.db
# MySQL example (requires pymysql, running MySQL server):
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/fastapi_db

DATABASE_TRACK_MODIFICATIONS=false

# --- CORS (JSON arrays) ---
CORS_ORIGINS=["*","http://localhost:3000","http://127.0.0.1:5173"]
CORS_METHODS=["*"]
CORS_HEADERS=["*"]

# --- App behavior ---
LOG_LEVEL=INFO
ENABLE_DEMO_MIDDLEWARE=false
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
